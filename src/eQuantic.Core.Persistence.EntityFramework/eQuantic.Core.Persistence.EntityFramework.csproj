<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The Entity Framework Core side of eQuantic.Core.Persistence: the DataModel conventions a DbContext
        applies in OnModelCreating (ApplyDataModelConventions, the EntityTypeBuilder extensions and their
        options). It keeps the eQuantic.Core.Persistence namespaces, so the provider packages that build on
        it (Relational, PostgreSql, MySql, SqlServer, MongoDb) read the same as before. The aggregate seam
        itself stays in eQuantic.Core.Persistence, which needs no Entity Framework.
    -->
    <PropertyGroup>
        <Description>eQuantic Persistence with Entity Framework Core Library</Description>
        <RootNamespace>eQuantic.Core.Persistence</RootNamespace>

        <PackageTags>eQuantic;Core;Persistence;EntityFramework;Library</PackageTags>
        <PackageReleaseNotes>Entity Framework Core conventions for the Persistence Layer</PackageReleaseNotes>
        <PackageIcon>Icon.png</PackageIcon>

    </PropertyGroup>

    <ItemGroup>
        <None Include="Icon.png" Pack="true" PackagePath="Icon.png" />
        <None Include="Icon_details.png" Pack="true" PackagePath="Icon_details.png" />
        <None Include="Icon_dialog.png" Pack="true" PackagePath="Icon_dialog.png" />
        <None Include="Icon_list.png" Pack="true" PackagePath="Icon_list.png" />
        <None Include="../../LICENSE" Pack="true" PackagePath="" />
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\eQuantic.Core.Persistence\eQuantic.Core.Persistence.csproj" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
        <PackageReference Include="eQuantic.Core.Data.EntityFramework" Version="8.8.1" />
    </ItemGroup>
    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <PackageReference Include="eQuantic.Core.Data.EntityFramework" Version="10.7.2" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="eQuantic.Core.Persistence.Relational" />
        <InternalsVisibleTo Include="eQuantic.Core.Persistence.PostgreSql" />
        <InternalsVisibleTo Include="eQuantic.Core.Persistence.MongoDb" />
        <InternalsVisibleTo Include="eQuantic.Core.Persistence.MySql" />
        <InternalsVisibleTo Include="eQuantic.Core.Persistence.SqlServer" />
    </ItemGroup>
</Project>
