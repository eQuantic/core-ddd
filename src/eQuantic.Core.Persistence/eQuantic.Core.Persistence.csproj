<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The aggregate seam: AggregateRepository, AggregateTracker and the unit of work that drains domain
        events into the outbox, over the native eQuantic.Core.Data repositories. It must not depend on
        Entity Framework Core or Humanizer: those belong to eQuantic.Core.Persistence.EntityFramework, so a
        project on a native engine takes the seam alone. PersistenceDependencyTests fails if either returns.
    -->
    <PropertyGroup>
        <Description>eQuantic Persistence Library</Description>
        <RootNamespace>eQuantic.Core.Persistence</RootNamespace>

        <PackageTags>eQuantic;Core;Persistence;Library</PackageTags>
        <PackageReleaseNotes>Aggregate repository and outbox unit of work over the native eQuantic.Core.Data repositories</PackageReleaseNotes>
        <PackageIcon>Icon.png</PackageIcon>

    </PropertyGroup>

    <ItemGroup>
        <None Include="Icon.png" Pack="true" PackagePath="Icon.png" />
        <None Include="Icon_details.png" Pack="true" PackagePath="Icon_details.png" />
        <None Include="Icon_dialog.png" Pack="true" PackagePath="Icon_dialog.png" />
        <None Include="Icon_list.png" Pack="true" PackagePath="Icon_list.png" />
        <None Include="../../LICENSE" Pack="true" PackagePath="" />
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\eQuantic.Core.Application\eQuantic.Core.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="eQuantic.Core.DataModel" Version="7.0.0" />
    </ItemGroup>
</Project>
